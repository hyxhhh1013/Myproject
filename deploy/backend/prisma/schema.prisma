generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int           @id @default(autoincrement())
  name        String
  title       String
  bio         String
  avatar      String
  email       String        @unique
  password    String        @default("$2a$10$xW7/X7v.p0yqQ/hJq.1/6.z7y.y7y.y7y.y7y.y7y.y7y.y7y")
  phone       String
  location    String
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  contacts    Contact[]
  education   Education[]
  experience  Experience[]
  projects    Project[]
  skills      Skill[]
  socialMedia SocialMedia[]

  @@map("user")
  @@index([email])
  @@index([createdAt])
  @@index([updatedAt])
}

model Education {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  school      String
  degree      String
  major       String
  startDate   DateTime  @map("start_date")
  endDate     DateTime? @map("end_date")
  description String
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("education")
  @@index([userId])
  @@index([startDate])
  @@index([createdAt])
}

model Experience {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  company     String
  position    String
  startDate   DateTime  @map("start_date")
  endDate     DateTime? @map("end_date")
  description String?
  images      String?
  isVisible   Boolean   @default(true) @map("is_visible")
  orderIndex  Int       @default(0) @map("order_index")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("experience")
  @@index([userId])
  @@index([isVisible])
  @@index([orderIndex])
  @@index([startDate])
  @@index([createdAt])
}

model Skill {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  name      String
  level     Int      @default(1)
  category  String
  isVisible Boolean  @default(true) @map("is_visible")
  orderIndex Int     @default(0) @map("order_index")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("skill")
  @@index([userId])
  @@index([isVisible])
  @@index([orderIndex])
  @@index([category])
  @@index([createdAt])
}

model Project {
  id                  Int       @id @default(autoincrement())
  userId              Int       @map("user_id")
  title               String
  description         String
  intro               String?
  startDate           DateTime  @map("start_date")
  endDate             DateTime? @map("end_date")
  technologies        String
  responsibilities    String?
  challengesProblem   String?   @map("challenges_problem")
  challengesSolution  String?   @map("challenges_solution")
  imageUrl            String?   @map("image_url")
  images              String?
  orderIndex          Int       @default(0) @map("order_index")
  githubUrl           String?   @map("github_url")
  demoUrl             String?   @map("demo_url")
  isVisible           Boolean   @default(true) @map("is_visible")
  isFeatured          Boolean   @default(false) @map("is_featured")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("project")
  @@index([userId])
  @@index([isVisible])
  @@index([isFeatured])
  @@index([orderIndex])
  @@index([startDate])
  @@index([createdAt])
}

model Contact {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  type      String
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("contact")
  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model SocialMedia {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  platform  String
  url       String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("social_media")
  @@index([userId])
  @@index([platform])
  @@index([createdAt])
}

model PhotoCategory {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  photos      Photo[]

  @@map("photo_category")
  @@index([slug])
  @@index([createdAt])
}

model Photo {
  id           Int           @id @default(autoincrement())
  title        String
  description  String?
  imageUrl     String        @map("image_url")
  thumbnailUrl String?       @map("thumbnail_url")
  categoryId   Int?          @map("category_id")
  isFeatured   Boolean       @default(false) @map("is_featured")
  isVisible    Boolean      @default(true) @map("is_visible")
  orderIndex   Int           @default(0) @map("order_index")
  takenAt      DateTime?     @map("taken_at")
  location     String?
  cameraModel  String?       @map("camera_model")
  lens         String?
  focalLength  String?       @map("focal_length")
  aperture     String?
  shutterSpeed String?       @map("shutter_speed")
  iso          String?
  exifData     String?       @map("exif_data")
  width        Int?
  height       Int?
  size         Int?
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  category     PhotoCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tags         Tag[]         @relation("PhotoTags")

  @@map("photo")
  @@index([categoryId])
  @@index([isVisible])
  @@index([isFeatured])
  @@index([orderIndex])
  @@index([takenAt])
  @@index([createdAt])
}

model Tag {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  photos    Photo[]  @relation("PhotoTags")

  @@map("tag")
  @@index([name])
  @@index([createdAt])
}

model Message {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String
  content   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("message")
  @@index([isRead])
  @@index([createdAt])
  @@index([email])
}

model Music {
  id           Int      @id @default(autoincrement())
  title        String
  artist       String?
  coverUrl     String?  @map("cover_url")
  platform     String   @default("netease")
  url          String?
  lyrics       String?
  orderIndex   Int      @default(0) @map("order_index")
  isVisible    Boolean  @default(true) @map("is_visible")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  description  String?
  playlistId   String?  @map("playlist_id")
  playlistType String?  @map("playlist_type")

  @@map("music")
  @@index([isVisible])
  @@index([orderIndex])
  @@index([platform])
  @@index([createdAt])
}

model Movie {
  id         Int       @id @default(autoincrement())
  title      String
  director   String?
  year       Int?
  posterUrl  String?   @map("poster_url")
  poster     String?
  isVisible  Boolean   @default(true)
  orderIndex Int       @default(0)
  likes      Int       @default(0)
  rating     Float?
  review     String?
  watchedAt  DateTime? @map("watched_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@map("movie")
  @@index([isVisible])
  @@index([orderIndex])
  @@index([year])
  @@index([rating])
  @@index([createdAt])
}

model TravelCity {
  id          Int       @id @default(autoincrement())
  name        String
  city        String?
  province    String?
  country     String    @default("中国")
  location    String?
  latitude    Float?
  longitude   Float?
  visitedAt   DateTime? @map("visited_at")
  description String?
  imageUrl    String?   @map("image_url")
  highlights  String?
  tips        String?
  rating      Float?
  photos      String?
  orderIndex  Int       @default(0) @map("order_index")
  isVisible   Boolean   @default(true) @map("is_visible")
  note        String?
  wantCount   Int       @default(0) @map("want_count")
  beenCount   Int       @default(0) @map("been_count")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("travel_city")
  @@index([isVisible])
  @@index([orderIndex])
  @@index([country])
  @@index([rating])
  @@index([createdAt])
}

model TravelFootprint {
  id          Int       @id @default(autoincrement())
  location    String
  latitude    Float
  longitude   Float
  visitedAt   DateTime? @map("visited_at")
  description String?
  photos      String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("travel_footprint")
  @@index([location])
  @@index([visitedAt])
  @@index([createdAt])
}

model SiteConfig {
  id             Int      @id @default(autoincrement())
  siteTitle      String   @default("My Portfolio") @map("site_title")
  seoKeywords    String?  @map("seo_keywords")
  seoDescription String?  @map("seo_description")
  icpCode        String?  @map("icp_code")
  viewCount      Int      @default(0) @map("view_count")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("site_config")
  @@index([createdAt])
  @@index([updatedAt])
}

model VisitorStat {
  id        Int      @id @default(autoincrement())
  date      DateTime @unique @default(now())
  count     Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("visitor_stat")
  @@index([date])
  @@index([createdAt])
}

model Danmaku {
  id        Int      @id @default(autoincrement())
  content   String
  color     String   @default("blue")
  isVisible Boolean  @default(true) @map("is_visible")
  orderIndex Int     @default(0) @map("order_index")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("danmaku")
  @@index([isVisible])
  @@index([orderIndex])
  @@index([createdAt])
}

model Moment {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  images    String?  @db.Text // JSON array of image URLs
  location  String?
  likes     Int      @default(0)
  isVisible Boolean  @default(true) @map("is_visible")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("moment")
  @@index([isVisible])
  @@index([likes])
  @@index([createdAt])
  @@index([location])
}
