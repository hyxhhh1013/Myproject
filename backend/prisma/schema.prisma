generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model dream_records {
  id                                                     String              @id
  user_id                                                String
  content                                                String              @db.Text
  emotion                                                String              @default("NEUTRAL")
  recorded_at                                            DateTime            @default(now())
  audio_url                                              String?
  analysis_result                                        String?             @db.Text
  cross_analysis                                         String?             @db.Text
  vividness                                              Int                 @default(0)
  terror                                                 Int                 @default(0)
  lucidity                                               Int                 @default(0)
  content_embedding                                      String?             @db.Text
  created_at                                             DateTime            @default(now())
  updated_at                                             DateTime
  deleted_at                                             DateTime?
  users                                                  users               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  dream_to_symbols                                       dream_to_symbols[]
  physiological_data                                     physiological_data?
  tarot_readings                                         tarot_readings[]
  topology_edges_topology_edges_source_idTodream_records topology_edges[]    @relation("topology_edges_source_idTodream_records")
  topology_edges_topology_edges_target_idTodream_records topology_edges[]    @relation("topology_edges_target_idTodream_records")

  @@index([recorded_at])
  @@index([user_id])
}

model dream_symbols {
  id                String             @id
  name              String             @unique @db.VarChar(255)
  universal_meaning String             @db.Text
  created_at        DateTime           @default(now())
  updated_at        DateTime
  dream_to_symbols  dream_to_symbols[]
}

model dream_to_symbols {
  id                   String        @id
  dream_record_id      String
  dream_symbol_id      String
  personalized_meaning String        @db.Text
  created_at           DateTime      @default(now())
  dream_records        dream_records @relation(fields: [dream_record_id], references: [id], onDelete: Cascade)
  dream_symbols        dream_symbols @relation(fields: [dream_symbol_id], references: [id], onDelete: Cascade)

  @@unique([dream_record_id, dream_symbol_id])
  @@index([dream_symbol_id], map: "dream_to_symbols_dream_symbol_id_fkey")
}

model insight_reports {
  id                String   @id
  user_id           String
  report_type       String
  period_start      DateTime
  period_end        DateTime
  summary           String   @db.Text
  detailed_analysis String   @db.Text
  created_at        DateTime @default(now())
  updated_at        DateTime
  users             users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, period_start, period_end])
}

model physiological_data {
  id               String        @id
  dream_record_id  String        @unique
  rem_heart_rate   Int?
  room_temperature Float?
  raw_health_data  String?       @db.Text
  device_source    String?
  created_at       DateTime      @default(now())
  updated_at       DateTime
  dream_records    dream_records @relation(fields: [dream_record_id], references: [id], onDelete: Cascade)
}

model tarot_favorites {
  id         String   @id
  user_id    String
  card_code  String
  card_name  String
  card_emoji String?
  created_at DateTime @default(now())
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, card_code])
  @@index([user_id, created_at])
}

model tarot_reading_cards {
  id               String         @id
  tarot_reading_id String
  position         Int
  card_code        String
  card_name        String
  card_emoji       String?
  is_reversed      Boolean        @default(false)
  upright_meaning  String         @db.Text
  reversed_meaning String         @db.Text
  created_at       DateTime       @default(now())
  tarot_readings   tarot_readings @relation(fields: [tarot_reading_id], references: [id], onDelete: Cascade)

  @@index([tarot_reading_id, position])
}

model tarot_readings {
  id                  String                @id
  user_id             String
  dream_record_id     String?
  spread_type         String                @default("three_card")
  question            String?               @db.Text
  ai_summary          String
  ai_interpretation   String                @db.Text
  ai_advice           String?               @db.Text
  created_at          DateTime              @default(now())
  tarot_reading_cards tarot_reading_cards[]
  dream_records       dream_records?        @relation(fields: [dream_record_id], references: [id])
  users               users                 @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([dream_record_id], map: "tarot_readings_dream_record_id_fkey")
  @@index([user_id, created_at])
}

model topology_edges {
  id                                                    String        @id
  source_id                                             String
  target_id                                             String
  weight                                                Float         @default(1)
  logic_relation                                        String?
  created_at                                            DateTime      @default(now())
  dream_records_topology_edges_source_idTodream_records dream_records @relation("topology_edges_source_idTodream_records", fields: [source_id], references: [id], onDelete: Cascade)
  dream_records_topology_edges_target_idTodream_records dream_records @relation("topology_edges_target_idTodream_records", fields: [target_id], references: [id], onDelete: Cascade)

  @@index([source_id])
  @@index([target_id])
}

model users {
  id              String            @id
  email           String            @unique
  name            String?
  password_hash   String
  encryption_key  String
  preferences     String?           @db.Text
  created_at      DateTime          @default(now())
  updated_at      DateTime
  deleted_at      DateTime?
  dream_records   dream_records[]
  insight_reports insight_reports[]
  tarot_favorites tarot_favorites[]
  tarot_readings  tarot_readings[]

  @@index([created_at])
}

model User {
  id          Int           @id @default(autoincrement())
  name        String
  title       String
  bio         String        @db.Text
  avatar      String        @db.Text
  email       String        @unique
  password    String        @default("$2a$10$xW7/X7v.p0yqQ/hJq.1/6.z7y.y7y.y7y.y7y.y7y.y7y.y7y")
  phone       String
  location    String
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  contacts    Contact[]
  education   Education[]
  experience  Experience[]
  projects    Project[]
  skills      Skill[]
  socialMedia SocialMedia[]

  @@index([email])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("user")
}

model Education {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  school      String
  degree      String
  major       String
  startDate   DateTime  @map("start_date")
  endDate     DateTime? @map("end_date")
  description String    @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([startDate])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("education")
}

model Experience {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  company     String
  position    String
  startDate   DateTime  @map("start_date")
  endDate     DateTime? @map("end_date")
  description String?   @db.Text
  images      String?   @db.Text
  isVisible   Boolean   @default(true) @map("is_visible")
  orderIndex  Int       @default(0) @map("order_index")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isVisible])
  @@index([orderIndex])
  @@index([startDate])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("experience")
}

model Skill {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  name       String
  level      Int      @default(1)
  category   String
  isVisible  Boolean  @default(true) @map("is_visible")
  orderIndex Int      @default(0) @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isVisible])
  @@index([orderIndex])
  @@index([category])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("skill")
}

model Project {
  id                 Int       @id @default(autoincrement())
  userId             Int       @map("user_id")
  title              String
  description        String    @db.Text
  intro              String?   @db.Text
  startDate          DateTime  @map("start_date")
  endDate            DateTime? @map("end_date")
  technologies       String    @db.Text
  responsibilities   String?   @db.Text
  challengesProblem  String?   @map("challenges_problem") @db.Text
  challengesSolution String?   @map("challenges_solution") @db.Text
  imageUrl           String?   @map("image_url") @db.Text
  images             String?   @db.Text
  orderIndex         Int       @default(0) @map("order_index")
  githubUrl          String?   @map("github_url") @db.Text
  demoUrl            String?   @map("demo_url") @db.Text
  isVisible          Boolean   @default(true) @map("is_visible")
  isFeatured         Boolean   @default(false) @map("is_featured")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isVisible])
  @@index([isFeatured])
  @@index([orderIndex])
  @@index([startDate])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("project")
}

model Contact {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  type      String
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("contact")
}

model SocialMedia {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  platform  String
  url       String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([platform])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("social_media")
}

model PhotoCategory {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String   @unique
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  photos      Photo[]

  @@index([slug])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("photo_category")
}

model Photo {
  id           Int            @id @default(autoincrement())
  title        String
  description  String?        @db.Text
  imageUrl     String         @map("image_url") @db.Text
  thumbnailUrl String?        @map("thumbnail_url") @db.Text
  categoryId   Int?           @map("category_id")
  isFeatured   Boolean        @default(false) @map("is_featured")
  isVisible    Boolean        @default(true) @map("is_visible")
  orderIndex   Int            @default(0) @map("order_index")
  takenAt      DateTime?      @map("taken_at")
  location     String?
  cameraModel  String?        @map("camera_model")
  lens         String?
  focalLength  String?        @map("focal_length")
  aperture     String?
  shutterSpeed String?        @map("shutter_speed")
  iso          String?
  exifData     String?        @map("exif_data") @db.Text
  width        Int?
  height       Int?
  size         Int?
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  category     PhotoCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tag          Tag[]          @relation("phototags")

  @@index([categoryId])
  @@index([isVisible])
  @@index([isFeatured])
  @@index([orderIndex])
  @@index([takenAt])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("photo")
}

model Tag {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  photo     Photo[]  @relation("phototags")

  @@index([name])
  @@index([createdAt])
  @@map("tag")
}

model Message {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String
  content   String   @db.Text
  reply     String?  @db.Text
  isRead    Boolean  @default(false) @map("is_read")
  isVisible Boolean  @default(true) @map("is_visible")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isRead])
  @@index([createdAt])
  @@index([email])
  @@index([updatedAt])
  @@map("message")
}

model Music {
  id           Int      @id @default(autoincrement())
  title        String
  artist       String?
  coverUrl     String?  @map("cover_url") @db.Text
  platform     String   @default("netease")
  url          String?  @db.Text
  lyrics       String?  @db.Text
  orderIndex   Int      @default(0) @map("order_index")
  isVisible    Boolean  @default(true) @map("is_visible")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  description  String?  @db.Text
  playlistId   String?  @map("playlist_id")
  playlistType String?  @map("playlist_type")

  @@index([isVisible])
  @@index([orderIndex])
  @@index([platform])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("music")
}

model Movie {
  id         Int       @id @default(autoincrement())
  title      String
  director   String?
  year       Int?
  posterUrl  String?   @map("poster_url") @db.Text
  poster     String?   @db.Text
  isVisible  Boolean   @default(true)
  orderIndex Int       @default(0)
  likes      Int       @default(0)
  rating     Float?
  review     String?   @db.Text
  watchedAt  DateTime? @map("watched_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([isVisible])
  @@index([orderIndex])
  @@index([year])
  @@index([rating])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("movie")
}

model TravelCity {
  id          Int       @id @default(autoincrement())
  name        String
  city        String?
  province    String?
  country     String    @default("中国")
  location    String?
  latitude    Float?
  longitude   Float?
  visitedAt   DateTime? @map("visited_at")
  description String?   @db.Text
  imageUrl    String?   @map("image_url") @db.Text
  highlights  String?   @db.Text
  tips        String?   @db.Text
  rating      Float?
  photos      String?   @db.Text
  orderIndex  Int       @default(0) @map("order_index")
  isVisible   Boolean   @default(true) @map("is_visible")
  note        String?   @db.Text
  wantCount   Int       @default(0) @map("want_count")
  beenCount   Int       @default(0) @map("been_count")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([isVisible])
  @@index([orderIndex])
  @@index([country])
  @@index([rating])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("travel_city")
}

model TravelFootprint {
  id          Int       @id @default(autoincrement())
  location    String
  latitude    Float
  longitude   Float
  visitedAt   DateTime? @map("visited_at")
  description String?   @db.Text
  photos      String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([location])
  @@index([visitedAt])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("travel_footprint")
}

model SiteConfig {
  id             Int      @id @default(autoincrement())
  siteTitle      String   @default("My Portfolio") @map("site_title")
  seoKeywords    String?  @map("seo_keywords") @db.Text
  seoDescription String?  @map("seo_description") @db.Text
  icpCode        String?  @map("icp_code")
  viewCount      Int      @default(0) @map("view_count")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([createdAt])
  @@index([updatedAt])
  @@map("site_config")
}

model VisitorStat {
  id        Int      @id @default(autoincrement())
  date      DateTime @unique @default(now())
  count     Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([date])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("visitor_stat")
}

model Danmaku {
  id         Int      @id @default(autoincrement())
  content    String   @db.Text
  color      String   @default("blue")
  isVisible  Boolean  @default(true) @map("is_visible")
  orderIndex Int      @default(0) @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([isVisible])
  @@index([orderIndex])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("danmaku")
}

model Moment {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  images    String?  @db.Text
  location  String?
  likes     Int      @default(0)
  isVisible Boolean  @default(true) @map("is_visible")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isVisible])
  @@index([likes])
  @@index([createdAt])
  @@index([location])
  @@index([updatedAt])
  @@map("moment")
}

model UploadedFile {
  id        Int      @id @default(autoincrement())
  filename  String   @unique
  mimeType  String   @map("mime_type")
  data      Bytes    @db.LongBlob
  size      Int
  createdAt DateTime @default(now()) @map("created_at")

  @@map("uploaded_file")
  @@index([filename])
}
